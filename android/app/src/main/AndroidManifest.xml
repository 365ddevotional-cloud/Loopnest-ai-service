<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Foreground service that keeps audio alive when the app is backgrounded.
            foregroundServiceType="mediaPlayback" tells Android this is a media
            playback service (required on API 29+ to allow background audio).
        -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Core network permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keep CPU + audio alive while music plays in the background -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required to start a foreground service (API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Required on API 34+ for foreground services that play audio.
        On older APIs this declaration is silently ignored.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        Show the MediaStyle notification on API 33+ (Android 13).
        The runtime permission dialog is shown automatically by the OS when
        the foreground service first calls startForeground().
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
